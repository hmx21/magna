# Requires the existing basic majority decoder plugin and controllers.json.
H 0 1
M 0 1
DETECTOR rec[-2]
DETECTOR rec[-1]
CONTROL[XOR](0) -> ctrl[0]
CONTROL[majority] det[0] det[1] ctrl[0] -> ctrl[0]
CX ctrl[0] 2
M 2
DETECTOR rec[-1]
CONTROL[majority] det[0] det[2] ctrl[0] -> ctrl[1]
CX ctrl[1] 3
POSTSELECT det[0] det[1]
